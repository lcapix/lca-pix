{
  "name": "lcapix-e2e-tester",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run --exclude-tag bugbash",
    "test:e2e:bugbash": "E2E_TELEMETRY_DISABLED=1 e2e run --tag bugbash",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.11.2",
    "@types/node": "^22.19.17",
    "e2e": "^0.16.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
