# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js (any nested checkout's build output too)
/.next/
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files with secrets — never tracked (prod values live in Vercel env vars)
.env
.env.local
.env*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# OS generated files
Thumbs.db

# Logs
logs
*.log
# credential walkthroughs + stray git-internals copies — never tracked
GET_ACCESS_KEYS_GUIDE.md
add-lca-pix-credentials.sh
.git-from-jul8-zip/
.git-stale-*

# docs site build output
docs/build/

# python bytecode from the factor-import scripts
__pycache__/
*.pyc

# per-developer Claude Code config (tool allowlists, local paths) — never tracked
.claude/settings.local.json
.claude/launch.json

# LCAPIX.zip is a byte-for-byte copy of design/legacy/LCAPIX/ (untracked
# 2026-10; the folder is the tracked copy)
/LCAPIX.zip
