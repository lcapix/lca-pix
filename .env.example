# LCAPIX environment variables: full reference
#
# Placeholders only; never put real values in a tracked file. For local
# development copy .env.local.example to .env.local instead. For a deploy,
# set these in the platform's environment settings (Vercel project env vars,
# Amplify console, ECS/App Runner task definition, docker --env-file).
# Values in "<...>" must be replaced. Empty optional values are fine.

# --- Database (MySQL 8) --- REQUIRED --------------------------------------
# No fallbacks in lib/db.ts: a missing value fails the first query with an
# error that names it. Use a least-privilege application user, not the RDS
# master user.
DATABASE_HOST="<DB_HOST>"
DATABASE_PORT=3306
DATABASE_USER="<DB_USER>"
DATABASE_PASSWORD="<DB_PASSWORD>"
DATABASE_NAME="<DB_NAME>"

# TLS to the database. Recommended (true) for anything not on localhost.
# DATABASE_SSL_CA: path to a PEM CA bundle, or the PEM text itself (handy for
# hosted env vars). For AWS RDS use the RDS global CA bundle.
DATABASE_SSL=
DATABASE_SSL_CA=

# --- Auth --- REQUIRED ------------------------------------------------------
# 32 random bytes, unique per environment:
#   openssl rand -base64 32
# Changing it signs every user out.
JWT_SECRET="<JWT_SECRET>"
# JWT_EXPIRES_IN=7d

# Public base URL of the deployment, e.g. https://<your-domain>
# (inlined into the client bundle at build time).
NEXT_PUBLIC_APP_URL="<APP_URL>"

# --- Google sign-in (optional) --------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Magic Insights / document ingestion LLM (optional) -------------------
HF_TOKEN=
# HF_INSIGHTS_MODEL=

# --- Data integrations (optional) -----------------------------------------
EIA_API_KEY=
BLS_API_KEY=
METALS_API_KEY=
ELECTRICITY_MAPS_API_KEY=

# --- Build flags (optional) -----------------------------------------------
# Set to 1 to emit .next/standalone for the Dockerfile / container deploys.
# BUILD_STANDALONE=1
