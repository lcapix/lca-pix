# Database Configuration (AWS RDS MySQL)
DATABASE_HOST=<RDS_HOST>
DATABASE_PORT=3306
DATABASE_NAME=lca_v3
DATABASE_USER=lcaadmin
DATABASE_PASSWORD=<DB_PASSWORD>

# AWS Configuration
AWS_REGION=us-east-1
AWS_SECRET_NAME=rds!db-fabed009-0d32-4d03-aa8a-54bb8209c1b4

# S3 Buckets
S3_BUCKET_ASSETS=lca-dev-assests
S3_BUCKET_BACKUPS=lca-dev-backups

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# IMPORTANT: Copy this file to .env.local and update with your values
# .env.local is gitignored and won't be committed to version control
