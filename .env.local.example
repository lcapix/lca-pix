# LCAPIX local development environment
#
#   cp .env.local.example .env.local     (.env.local is gitignored)
#
# Placeholders only. Never commit real values to this file or any other
# tracked file; production values live in the deployment's env settings
# (Vercel project env vars, Amplify console, container task definition).
# Values in "<...>" must be replaced. Empty optional values are fine.

# --- Database (Postgres 17) --- REQUIRED ---------------------------------
# lib/db.ts has no fallbacks: the first query fails with an error naming any
# of these that are missing. Either a connection string (what Neon and other
# hosts give; its sslmode applies):
DATABASE_URL=
# or the separate values. Point them at a LOCAL database for development,
# e.g. host 127.0.0.1 and a database you created yourself. Never point a dev
# checkout at production.
DATABASE_HOST="<DB_HOST>"
DATABASE_PORT=5432
DATABASE_USER="<DB_USER>"
# May be empty for a local user with trusted login, but must be present.
DATABASE_PASSWORD="<DB_PASSWORD>"
DATABASE_NAME="<DB_NAME>"

# Optional TLS with the separate values. Set DATABASE_SSL=true to connect over
# TLS with certificate verification. DATABASE_SSL_CA is a path to a PEM CA
# bundle or the PEM text itself.
DATABASE_SSL=
DATABASE_SSL_CA=

# --- Auth --- REQUIRED ------------------------------------------------------
# Generate your own; never reuse another environment's secret:
#   openssl rand -base64 32
JWT_SECRET="<JWT_SECRET>"
# Token lifetime (optional, default 7d)
# JWT_EXPIRES_IN=7d

# Public base URL of this app (used for the Google OAuth redirect).
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Google sign-in (optional) --------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Magic Insights / document ingestion LLM (optional) -------------------
# Hugging Face token; leave empty to disable AI narration.
HF_TOKEN=
# HF_INSIGHTS_MODEL=

# --- Data integrations (optional; leave empty to use the static data) -----
EIA_API_KEY=
BLS_API_KEY=
METALS_API_KEY=
ELECTRICITY_MAPS_API_KEY=
